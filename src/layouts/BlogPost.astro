---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { DEFAULT_LOCALE, type Locale } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	locale?: Locale;
	headings?: MarkdownHeading[];
	previousPost?: PostNavItem;
	nextPost?: PostNavItem;
};

type PostNavItem = {
	href: string;
	title: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	locale = DEFAULT_LOCALE,
	headings = [],
	previousPost,
	nextPost,
} = Astro.props;

const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocTitle = locale === 'zh-Hans' ? '文章大纲' : 'On This Page';
const navigationLabels = {
	previous: locale === 'zh-Hans' ? '上一篇' : 'Previous',
	next: locale === 'zh-Hans' ? '下一篇' : 'Next',
	noPrevious: locale === 'zh-Hans' ? '没有上一篇' : 'No Previous Post',
	noNext: locale === 'zh-Hans' ? '没有下一篇' : 'No Next Post',
};
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1180px, calc(100% - 2rem));
				margin: 0;
				margin-inline: auto;
				padding-top: 4rem;
			}
			.hero-image {
				grid-column: 1 / -1;
				width: min(var(--container-wide), 100%);
				margin: 0 auto 3rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				border: 1px solid var(--border-color);
				border-radius: 10px;
			}
			.prose {
				width: min(var(--container-width), 100%);
				color: var(--text-color);
				font-size: 1.05rem;
				line-height: 1.8;
			}
			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, var(--container-width)) 260px;
				gap: 4rem;
				align-items: start;
				justify-content: center;
			}
			.content-column {
				min-width: 0;
			}
			.toc {
				position: sticky;
				top: 6rem;
				max-height: calc(100vh - 8rem);
				overflow-y: auto;
				padding: 1.25rem;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				background: var(--surface-bg);
			}
			.toc-title {
				margin: 0 0 1rem;
				color: var(--muted-color);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.toc ol {
				display: grid;
				gap: 0.15rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc a {
				display: block;
				padding: 0.45rem 0 0.45rem 0.75rem;
				border-left: 2px solid var(--border-color);
				color: var(--muted-color);
				font-size: 0.9rem;
				line-height: 1.45;
				text-decoration: none;
			}
			.toc a:hover,
			.toc a.is-active {
				border-left-color: var(--accent);
				color: var(--heading-color);
			}
			.toc .depth-3 a {
				padding-left: 1.55rem;
				font-size: 0.84rem;
			}
			.title {
				margin-bottom: 3rem;
				padding: 0 0 2rem;
				border-bottom: 1px solid var(--border-color);
				line-height: 1.2;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.2rem, 7vw, 4rem);
				line-height: 1.05;
			}
			.date {
				margin-bottom: 1rem;
				color: var(--muted-color);
				font-size: 0.95rem;
				line-height: 1.5;
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(p),
			.prose :global(ul),
			.prose :global(ol),
			.prose :global(blockquote) {
				margin-bottom: 1.45rem;
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 2.75rem;
				margin-bottom: 1rem;
				scroll-margin-top: 5rem;
			}
			.prose :global(h2) {
				font-size: 1.65rem;
			}
			.prose :global(h3) {
				font-size: 1.3rem;
			}
			.prose :global(a) {
				font-weight: 700;
				border-bottom: 1px solid color-mix(in srgb, var(--accent), transparent 62%);
			}
			.prose :global(a:hover) {
				border-bottom-color: var(--accent);
			}
			.prose :global(blockquote) {
				margin-left: 0;
				padding: 0.15rem 0 0.15rem 1.25rem;
				border-left: 3px solid var(--border-color);
				color: var(--muted-color);
			}
			.prose :global(img) {
				max-width: 100%;
				border-radius: 10px;
			}
			.prose :global(table) {
				width: 100%;
				max-width: 100%;
				margin: 2rem 0;
				border-collapse: collapse;
				border-spacing: 0;
				font-size: 0.95rem;
				line-height: 1.65;
			}
			.prose :global(thead) {
				background: var(--inline-code-bg);
			}
			.prose :global(th),
			.prose :global(td) {
				min-width: 8rem;
				padding: 0.85rem 1rem;
				border: 1px solid var(--border-color);
				text-align: left;
				vertical-align: top;
			}
			.prose :global(th) {
				color: var(--heading-color);
				font-weight: 700;
			}
			.prose :global(td) {
				color: var(--text-color);
			}
			.prose :global(tbody tr:nth-child(even)) {
				background: color-mix(in srgb, var(--surface-bg), var(--inline-code-bg) 42%);
			}
			.prose :global(pre) {
				margin: 2rem 0;
				padding: 1.25rem;
				border-radius: 10px;
				background: var(--code-bg) !important;
				color: var(--code-color) !important;
				font-size: 0.92rem;
			}
			.prose :global(:not(pre) > code) {
				color: var(--heading-color);
				white-space: break-spaces;
			}
			.prose :global(.mermaid) {
				margin: 2rem 0;
				padding: 1.5rem;
				overflow-x: auto;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				background: var(--surface-bg);
				text-align: center;
			}
			.prose :global(.mermaid svg) {
				max-width: 100%;
				height: auto;
			}
			.post-navigation {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-color);
			}
			.post-nav-card {
				display: grid;
				min-width: 0;
				min-height: 116px;
				align-content: center;
				gap: 0.55rem;
				padding: 1.15rem;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				background: var(--surface-bg);
				color: var(--text-color);
				text-decoration: none;
			}
			.post-nav-card:hover {
				border-color: var(--accent);
				background: var(--inline-code-bg);
				color: var(--text-color);
			}
			.post-nav-card.is-disabled {
				opacity: 0.48;
			}
			.post-nav-card.next {
				text-align: right;
			}
			.post-nav-label {
				color: var(--muted-color);
				font-size: 0.92rem;
				line-height: 1.35;
			}
			.post-nav-title {
				overflow: hidden;
				color: var(--accent);
				font-size: 1.08rem;
				font-weight: 700;
				line-height: 1.35;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.post-nav-card.is-disabled .post-nav-title {
				color: var(--muted-color);
			}
			@media (max-width: 720px) {
				main {
					width: min(var(--container-wide), calc(100% - 1.5rem));
					padding-top: 3rem;
				}
				.hero-image {
					margin-bottom: 2rem;
				}
				.title {
					margin-bottom: 2.25rem;
					padding-bottom: 1.5rem;
				}
				.post-navigation {
					grid-template-columns: 1fr;
					margin-top: 3rem;
				}
				.post-nav-card.next {
					text-align: left;
				}
				.prose :global(table) {
					display: block;
					overflow-x: auto;
				}
			}
			@media (max-width: 1120px) {
				main {
					width: min(var(--container-width), calc(100% - 2rem));
				}
				.post-shell {
					display: block;
				}
				.toc {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header locale={locale} />
		<main data-pagefind-body>
			<article class="post-shell">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="content-column prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
					<nav class="post-navigation" aria-label="Post navigation" data-pagefind-ignore>
						{
							previousPost ? (
								<a class="post-nav-card previous" href={previousPost.href} title={previousPost.title}>
									<span class="post-nav-label">{navigationLabels.previous}</span>
									<span class="post-nav-title">« {previousPost.title}</span>
								</a>
							) : (
								<div class="post-nav-card previous is-disabled" aria-disabled="true">
									<span class="post-nav-label">{navigationLabels.previous}</span>
									<span class="post-nav-title">{navigationLabels.noPrevious}</span>
								</div>
							)
						}
						{
							nextPost ? (
								<a class="post-nav-card next" href={nextPost.href} title={nextPost.title}>
									<span class="post-nav-label">{navigationLabels.next}</span>
									<span class="post-nav-title">{nextPost.title} »</span>
								</a>
							) : (
								<div class="post-nav-card next is-disabled" aria-disabled="true">
									<span class="post-nav-label">{navigationLabels.next}</span>
									<span class="post-nav-title">{navigationLabels.noNext}</span>
								</div>
							)
						}
					</nav>
				</div>
				{
					tocHeadings.length > 0 && (
						<aside class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
							<p class="toc-title" id="toc-title">
								{tocTitle}
							</p>
							<ol>
								{tocHeadings.map((heading) => (
									<li class={`depth-${heading.depth}`}>
										<a class="toc-link" href={`#${heading.slug}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ol>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
		<script>
			const mermaidBlocks = document.querySelectorAll(
				'pre[data-language="mermaid"], pre > code.language-mermaid'
			);

			if (mermaidBlocks.length > 0) {
				import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
					.then(({ default: mermaid }) => {
						mermaid.initialize({
							startOnLoad: false,
							theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
						});

						mermaidBlocks.forEach((block, index) => {
							const pre = block.tagName === 'PRE' ? block : block.parentElement;
							const source = pre?.textContent ?? block.textContent ?? '';
							const container = document.createElement('div');
							container.className = 'mermaid';
							container.textContent = source;
							container.id = `mermaid-${index}`;
							pre?.replaceWith(container);
						});

						mermaid.run({ querySelector: '.mermaid' });
					})
					.catch((error) => {
						console.warn('Mermaid rendering failed; showing source blocks instead.', error);
					});
			}
		</script>
		<script>
			const tocLinks = [...document.querySelectorAll('.toc-link')];
			const sections = tocLinks
				.map((link) => {
					const id = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '');
					const section = id ? document.getElementById(id) : null;
					return section ? { link, section } : null;
				})
				.filter(Boolean);

			if (sections.length > 0) {
				const setActive = (activeLink) => {
					tocLinks.forEach((link) => link.classList.toggle('is-active', link === activeLink));
				};

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

						if (!visible) return;

						const current = sections.find((item) => item.section === visible.target);
						if (current) setActive(current.link);
					},
					{
						rootMargin: '-20% 0px -70% 0px',
						threshold: 0,
					}
				);

				sections.forEach(({ section }) => observer.observe(section));
				setActive(sections[0].link);
			}
		</script>
	</body>
</html>
