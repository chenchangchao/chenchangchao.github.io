---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getPostHref, getPostLocale, getPostSlug } from '../../../consts';

type PostNavItem = {
	href: string;
	title: string;
};

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => getPostLocale(post.id) === 'en-US')
		.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

	return posts.map((post, index) => ({
			params: { slug: getPostSlug(post.id) },
			props: {
				post,
				previousPost: posts[index - 1]
					? {
							href: getPostHref('en-US', posts[index - 1].id),
							title: posts[index - 1].data.title,
						}
					: undefined,
				nextPost: posts[index + 1]
					? {
							href: getPostHref('en-US', posts[index + 1].id),
							title: posts[index + 1].data.title,
						}
					: undefined,
			},
		}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	previousPost?: PostNavItem;
	nextPost?: PostNavItem;
};

const { post, previousPost, nextPost } = Astro.props;
const locale = getPostLocale(post.id);
const { Content, headings } = await render(post);
---

<BlogPost
	{...post.data}
	locale={locale}
	headings={headings}
	previousPost={previousPost}
	nextPost={nextPost}
>
	<Content />
</BlogPost>
