---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getPostHref, getPostLocale, SITE } from '../../consts';

const locale = 'zh-Hans';
const meta = SITE[locale];
const posts = (await getCollection('blog'))
	.filter((post) => getPostLocale(post.id) === locale && post.id.toLowerCase().startsWith('zh-hans/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`博客 - ${meta.title}`} description={meta.description} />
		<style>
			main {
				width: min(var(--container-wide), calc(100% - 2rem));
			}
			.blog-header {
				margin-bottom: 3.5rem;
			}
			.blog-header p {
				max-width: 42rem;
				color: var(--muted-color);
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 2.75rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				padding-bottom: 2.75rem;
				border-bottom: 1px solid var(--border-color);
			}
			.post-link {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 168px;
				gap: 1.5rem;
				align-items: start;
				color: inherit;
				text-decoration: none;
			}
			.post-content {
				min-width: 0;
			}
			.date {
				margin: 0;
				color: var(--muted-color);
				font-size: 0.9rem;
				line-height: 1.4;
			}
			.title {
				margin: 0.7rem 0 0.9rem;
				color: var(--heading-color);
				font-size: clamp(1.35rem, 3vw, 1.75rem);
				line-height: 1.25;
			}
			.description {
				margin: 0;
				color: var(--muted-color);
				font-size: 1rem;
				line-height: 1.75;
			}
			.post-link:hover .title {
				color: var(--accent);
			}
			.post-link:hover img {
				border-color: var(--accent);
				transform: translateY(-2px);
			}
			.post-link img {
				width: 168px;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				border: 1px solid var(--border-color);
				border-radius: 8px;
				transition:
					border-color 180ms ease,
					transform 180ms ease;
			}
			@media (max-width: 680px) {
				main {
					width: min(var(--container-wide), calc(100% - 1.5rem));
				}
				.blog-header {
					margin-bottom: 2.5rem;
				}
				.post-list {
					gap: 2.25rem;
				}
				.post-card {
					padding-bottom: 2.25rem;
				}
				.post-link {
					grid-template-columns: 1fr;
				}
				.post-link img {
					width: 100%;
					aspect-ratio: 16 / 9;
					order: -1;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main data-pagefind-body>
			<div class="blog-header">
				<h1>博客</h1>
				<p>AI Agent、RAG、TypeScript 全栈开发和工程实践的长期笔记。</p>
			</div>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a class="post-link" href={getPostHref(locale, post.id)}>
									<div class="post-content">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h2 class="title">{post.data.title}</h2>
										<p class="description">{post.data.description}</p>
									</div>
									{post.data.heroImage && <Image width={336} height={252} src={post.data.heroImage} alt="" />}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
