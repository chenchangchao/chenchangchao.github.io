---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

const locale = 'zh-Hans';
const meta = SITE[locale];
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`关于 - ${meta.title}`} description={meta.description} />
	</head>
	<body>
		<Header locale={locale} />

		<main>
			<h1>关于我</h1>

			<p>
				你好，我是陈常超。这里是我的个人技术博客，用来记录 AI Agent、数据分析、
				TypeScript 全栈开发、RAG、自动化报表和个人项目实践。
			</p>

			<p>
				我希望把真实项目中的问题、踩坑记录、技术方案和复盘总结沉淀下来，
				形成一个长期积累的技术作品集。
			</p>

			<p>
				GitHub：
				<a href="https://github.com/chenchangchao" target="_blank">
					chenchangchao
				</a>
			</p>
		</main>

		<Footer />
	</body>
</html>