---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import { siteMeta } from "../i18n";
import { getPostHref, getPostLocale } from "../consts";
const locale = "zh-Hans";
const meta = siteMeta[locale];
const recentPosts = (await getCollection("blog"))
  .filter((post) => getPostLocale(post.id) === locale && post.id.toLowerCase().startsWith("zh-hans/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const featured = [
  {
    title: "AI Agent 开发",
    description: "围绕工具调用、记忆、规划与本地运行时，沉淀可复用的 Agent 工程模式。",
    href: "/blog/agent-01-runtime-local-tools/",
  },
  {
    title: "MCP Server 搭建",
    description: "从协议、资源、工具到部署，把模型上下文协议落到真实开发流程里。",
    href: "/blog/mcp-started/",
  },
  {
    title: "数据自动化清洗引擎",
    description: "面向采集、清洗、入库、调度、监控与报表生成的数据工程实践。",
    href: "/blog/data-analysis-solid-code/",
  },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={meta.title} description={meta.description} />
  </head>
  <body>
    <Header locale={locale} />
    <main class="home" data-pagefind-body>
      <section class="hero">
        <p class="eyebrow">Hardcore technical notes</p>
        <h1>{meta.title}</h1>
        <p class="lead">{meta.description}</p>
        <div class="hero-actions">
          <a class="primary-link" href="/blog/">阅读博客文章</a>
          <a class="secondary-link" href="/about/">了解我的技术栈</a>
        </div>
      </section>

      <section class="section-block" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">最新文章</h2>
          <a href="/blog/">全部文章</a>
        </div>
        <div class="recent-list">
          {
            recentPosts.map((post) => (
              <a class="recent-item" href={getPostHref(locale, post.id)}>
                <p class="date">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section-block" aria-labelledby="featured-work">
        <div class="section-heading">
          <h2 id="featured-work">精选项目</h2>
        </div>
        <div class="featured-grid">
          {
            featured.map((item) => (
              <a class="featured-card" href={item.href}>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </a>
            ))
          }
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .home {
    width: min(var(--container-wide), calc(100% - 2rem));
  }

  .hero {
    max-width: 760px;
    padding-bottom: 4rem;
  }

  .eyebrow {
    margin-bottom: 0.8rem;
    color: var(--muted-color);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 46rem;
    color: var(--muted-color);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 1rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .primary-link {
    background: var(--heading-color);
    color: var(--page-bg);
    border-color: var(--heading-color);
  }

  .primary-link:hover {
    color: var(--page-bg);
    opacity: 0.84;
  }

  .secondary-link {
    color: var(--text-color);
    background: var(--surface-bg);
  }

  .section-block {
    padding: 3rem 0;
    border-top: 1px solid var(--border-color);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .section-heading a {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .recent-list {
    display: grid;
    gap: 0;
  }

  .recent-item {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-color);
    color: inherit;
  }

  .recent-item:first-child {
    border-top: 0;
  }

  .recent-item:hover h3 {
    color: var(--accent);
  }

  .recent-item .date {
    margin: 0;
    color: var(--muted-color);
    font-size: 0.88rem;
  }

  .recent-item h3,
  .featured-card h3 {
    margin: 0;
    color: var(--heading-color);
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .recent-item p,
  .featured-card p {
    margin: 0;
    color: var(--muted-color);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .featured-card {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-height: 190px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-bg);
    color: inherit;
  }

  .featured-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  @media (max-width: 780px) {
    .home {
      width: min(var(--container-wide), calc(100% - 1.5rem));
    }

    .hero {
      padding-bottom: 3rem;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
