---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../consts';

const locale = 'en-US';
const meta = SITE[locale];
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`About - ${meta.title}`} description={meta.description} />
	</head>
	<body>
		<Header locale={locale} />

		<main>
			<h1>About Me</h1>

			<p>
				Hi, I am Changchao Chen. This is my personal tech blog for notes on
				AI agents, data analytics, TypeScript full-stack development, RAG,
				automation, and personal engineering projects.
			</p>

			<p>
				I use this site as a long-term archive for technical learning,
				project experience, problem-solving notes, and portfolio building.
			</p>

			<p>
				GitHub:
				<a href="https://github.com/chenchangchao" target="_blank">
					chenchangchao
				</a>
			</p>
		</main>

		<Footer />
	</body>
</html>