---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../consts';

const locale = 'en-US';
const meta = SITE[locale];
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={meta.title} description={meta.description} />
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<h1>Chen Changchao's Blog</h1>

			<p>
				I write about AI agents, data analytics, TypeScript full-stack development,
				RAG, automation, and practical engineering notes from real projects.
			</p>

			<p>
				This site is my long-term archive for technical learning, project experience,
				and problem-solving notes.
			</p>

			<p>
				<a href="/en-US/blog/">Read blog posts →</a>
			</p>
		</main>
		<Footer />
	</body>
</html>