---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteMeta } from "../i18n";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
const locale = "zh-Hans";
const meta = siteMeta[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={meta.title} description={meta.description} />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <h1>{meta.title}</h1>
      <p>
        {meta.description}
        {/* {SITE_DESCRIPTION} */}
        {/* {SITE_TITLE} */}
      </p>
      <p>
        <a href="/blog/">阅读博客文章 →</a>
      </p>
      <p>
        Looking for a blog template with a bit more personality? Check out
        <a href="https://github.com/Charca/astro-blog-template"
          >astro-blog-template</a
        >
        by <a href="https://twitter.com/Charca">Maxi Ferreira</a>.
      </p>
    </main>
    <Footer />
  </body>
</html>
