---
import {
  DEFAULT_LOCALE,
  NAV,
  SITE,
  type Locale,
  localizedPath,
  switchLocalePath,
} from "../consts";
import HeaderLink from "./HeaderLink.astro";
import SearchDialog from "./SearchDialog.astro";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const nav = NAV[locale];
const site = SITE[locale];

const targetLocale: Locale = locale === "zh-Hans" ? "en-US" : "zh-Hans";
const languageSwitchHref = switchLocalePath(targetLocale, Astro.url.pathname);

const themeLabels = {
  "zh-Hans": {
    system: "跟随系统",
    light: "浅色",
    dark: "深色",
  },
  "en-US": {
    system: "System",
    light: "Light",
    dark: "Dark",
  },
} as const;

const theme = themeLabels[locale];
---

<header>
  <nav>
    <a class="site-title" href={localizedPath(locale, "/")}>{site.title}</a>

    <div class="internal-links">
      <HeaderLink href={localizedPath(locale, "/")}>{nav.home}</HeaderLink>
      <HeaderLink href={localizedPath(locale, "/blog/")}>{nav.blog}</HeaderLink>
      <HeaderLink href={localizedPath(locale, "/about/")}
        >{nav.about}</HeaderLink
      >
    </div>

    <div class="right-actions">
      <SearchDialog locale={locale} />
      <a class="language-button" href={languageSwitchHref}>{nav.language}</a>

      <label class="theme-select-label">
        <span class="sr-only">Theme</span>
        <select data-theme-select aria-label="Theme">
          <option value="system">{theme.system}</option>
          <option value="light">{theme.light}</option>
          <option value="dark">{theme.dark}</option>
        </select>
      </label>
      <a
        class="icon-link"
        href="https://github.com/chenchangchao/chenchangchao.github.io"
        target="_blank"
      >
        <span class="sr-only">Go to Astro's GitHub repo</span>
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          width="20"
          height="20"
          astro-icon="social/github"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const storageKey = "site-theme";
    const select = document.querySelector("[data-theme-select]");
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    const getResolvedTheme = (theme) => {
      if (theme === "dark" || theme === "light") return theme;
      return media.matches ? "dark" : "light";
    };

    const applyTheme = (theme) => {
      document.documentElement.dataset.themeMode = theme;
      document.documentElement.dataset.theme = getResolvedTheme(theme);
    };

    const savedTheme = localStorage.getItem(storageKey) || "system";

    if (select) {
      select.value = savedTheme;

      select.addEventListener("change", (event) => {
        const nextTheme = event.currentTarget.value;
        localStorage.setItem(storageKey, nextTheme);
        applyTheme(nextTheme);
      });
    }

    media.addEventListener("change", () => {
      const currentTheme = localStorage.getItem(storageKey) || "system";
      if (currentTheme === "system") {
        applyTheme("system");
      }
    });
  })();
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    margin: 0;
    padding: 0 1em;
    background: var(--header-bg);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(18px);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1120px;
    margin: 0 auto;
    min-height: 64px;
  }

  .site-title {
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 0.55em;
    color: var(--text-color);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }

  .internal-links,
  .right-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .language-button,
  .icon-link,
  select {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--control-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
  }

  .language-button,
  .icon-link {
    min-height: 38px;
  }

  .language-button {
    padding: 0 0.8rem;
  }

  .icon-link {
    width: 38px;
    padding: 0;
  }

  .icon-link svg {
    display: block;
    width: 20px;
    height: 20px;
  }

  select {
    min-height: 38px;
    padding: 0 0.75rem;
    cursor: pointer;
  }

  @media (max-width: 820px) {
    header {
      padding: 0 0.75rem;
    }

    nav {
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
      min-height: 0;
      padding: 0.5rem 0;
    }

    .site-title {
      width: 100%;
      min-height: 32px;
      padding: 0.15rem 0;
      justify-content: flex-start;
    }

    .internal-links,
    .right-actions {
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    nav a {
      min-height: 34px;
      padding: 0 0.4rem;
      font-size: 0.9rem;
    }

    .language-button,
    .icon-link,
    :global(.search-trigger),
    select {
      min-height: 34px;
      font-size: 0.8rem;
    }

    .icon-link {
      width: 34px;
    }
  }
</style>
